{
  "expo": {
    "name": "ESP32ar",
    "slug": "ESP32ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/air-conditioner.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/air-conditioner.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
